# Optional Docker values.
# For browser testing, localhost is fine.
# For Expo Go on a physical phone, set LAN_IP to your computer's Wi-Fi IP address.
# Windows example command to find it: ipconfig
LAN_IP=localhost

# Set true only when the Expo QR code cannot open from your phone on the same Wi-Fi.
# Tunnel may be slower but usually works across networks.
EXPO_TUNNEL=false

# Development can leave MFA off. Production forces administrator MFA even if
# this value is false and requires SMTP plus a strong secret pepper.
ADMIN_MFA_REQUIRED=false
ADMIN_MFA_PEPPER=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MansaMart <no-reply@mansamart.gm>

# Do not enable Wave until GMD Checkout support is confirmed for your wallet.
WAVE_ENABLED=false
WAVE_GMD_CONFIRMED=false
WAVE_API_KEY=
WAVE_REQUEST_SIGNING_SECRET=
WAVE_WEBHOOK_SECRET=
WAVE_CURRENCY=GMD

# Authentication and push providers stay off until their credentials exist.
PHONE_OTP_ENABLED=false
PHONE_OTP_PEPPER=
PHONE_OTP_DEV_EXPOSE_CODE=false
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_SENDER_ID=MansaMart
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=gm.mansamart.customer,gm.mansamart.business,gm.mansamart.rider
EXPO_ACCESS_TOKEN=
GOOGLE_CUSTOMER_WEB_CLIENT_ID=
GOOGLE_CUSTOMER_ANDROID_CLIENT_ID=
GOOGLE_CUSTOMER_IOS_CLIENT_ID=
GOOGLE_BUSINESS_WEB_CLIENT_ID=
GOOGLE_BUSINESS_ANDROID_CLIENT_ID=
GOOGLE_BUSINESS_IOS_CLIENT_ID=
GOOGLE_RIDER_WEB_CLIENT_ID=
GOOGLE_RIDER_ANDROID_CLIENT_ID=
GOOGLE_RIDER_IOS_CLIENT_ID=
