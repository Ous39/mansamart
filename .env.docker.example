# Optional Docker values.
# For browser testing, localhost is fine.
# For Expo Go on a physical phone, set LAN_IP to your computer's Wi-Fi IP address.
# Windows example command to find it: ipconfig
LAN_IP=localhost

# Set true only when the Expo QR code cannot open from your phone on the same Wi-Fi.
# Tunnel may be slower but usually works across networks.
EXPO_TUNNEL=false

# Do not enable Wave until GMD Checkout support is confirmed for your wallet.
WAVE_ENABLED=false
WAVE_GMD_CONFIRMED=false
WAVE_API_KEY=
WAVE_REQUEST_SIGNING_SECRET=
WAVE_WEBHOOK_SECRET=
WAVE_CURRENCY=GMD
