{
  "name": "@mansamart/database",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "esbuild src/schema.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/schema.js",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push --config=drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.9",
    "typescript": "~5.9.2"
  }
}
