EXPO_PUBLIC_API_URL=http://YOUR-LAPTOP-IP:5000
EXPO_PUBLIC_APP_AUDIENCE=rider
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Native Google Maps SDK keys. Restrict each key to the matching app ID.
# Android package: gm.mansamart.rider
# iOS bundle ID: gm.mansamart.rider
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
