{
  "name": "@mansamart/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "esbuild src/client-access.test.ts --bundle --platform=node --format=esm --outfile=.test-dist/client-access.test.mjs && node --test .test-dist/client-access.test.mjs",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@mansamart/database": "workspace:*",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "express": "^5.0.1",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  }
}
