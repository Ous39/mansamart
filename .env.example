DATABASE_URL=postgres://mansamart:change-me@localhost:5432/mansamart
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:4173,http://localhost:4174,http://localhost:8081,http://localhost:8082,http://localhost:8083
ADMIN_CORS_ORIGINS=http://localhost:4174
PUBLIC_API_URL=http://127.0.0.1:5000

# Production always requires administrator email MFA. Use a long random pepper
# stored only in the API secret manager. Development can opt in explicitly.
ADMIN_MFA_REQUIRED=false
ADMIN_MFA_PEPPER=

# Wave Checkout stays disabled until Wave has approved the business wallet,
# issued the secrets, and confirmed that this wallet supports GMD Checkout.
WAVE_ENABLED=false
WAVE_GMD_CONFIRMED=false
WAVE_API_BASE_URL=https://api.wave.com
WAVE_API_KEY=
WAVE_REQUEST_SIGNING_SECRET=
WAVE_WEBHOOK_SECRET=
WAVE_CURRENCY=GMD
WAVE_SUCCESS_URL=https://mansamart.gm/payment/wave/success
WAVE_ERROR_URL=https://mansamart.gm/payment/wave/error

# WhatsApp Cloud API stays inactive until the Meta Business account, app,
# business phone number and webhook are verified. Never expose these values
# through EXPO_PUBLIC_* or VITE_* variables.
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_SYSTEM_ACCESS_TOKEN=

# Email delivery for password resets. In production, SMTP must use TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MansaMart <no-reply@mansamart.gm>"
PASSWORD_RESET_URL=https://mansamart.gm/reset-password

# Passwordless phone authentication. Production requires a 32+ character
# pepper and an HTTPS SMS provider endpoint accepting {to,sender,message}.
PHONE_OTP_ENABLED=false
PHONE_OTP_PEPPER=
PHONE_OTP_DEV_EXPOSE_CODE=false
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_SENDER_ID=MansaMart

# Exact OAuth client IDs accepted by the API after signature verification.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=gm.mansamart.customer,gm.mansamart.business,gm.mansamart.rider

# Optional Expo enhanced-push-security token. Keep it server-side only.
EXPO_ACCESS_TOKEN=

# Require certificate verification for hosted PostgreSQL in production.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Manual wallet funding is intentionally disabled until an approved provider
# and the legal/accounting flow are ready.
WALLET_PAYMENTS_ENABLED=false
