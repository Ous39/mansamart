{
  "name": "mansamart",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @mansamart/api --filter @mansamart/web --filter @mansamart/admin-web dev",
    "dev:api": "pnpm --filter @mansamart/api dev",
    "dev:customer": "pnpm --filter @mansamart/customer-mobile dev",
    "dev:business": "pnpm --filter @mansamart/business-mobile dev",
    "dev:rider": "pnpm --filter @mansamart/rider-mobile dev",
    "dev:web": "pnpm --filter @mansamart/web dev",
    "dev:admin": "pnpm --filter @mansamart/admin-web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "db:push": "pnpm --filter @mansamart/database db:push",
    "db:seed": "pnpm --filter @mansamart/api seed",
    "docker:up": "docker compose -f infrastructure/docker-compose.yml up --build",
    "docker:down": "docker compose -f infrastructure/docker-compose.yml down",
    "docker:logs": "docker compose -f infrastructure/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
